---
import { Image } from 'astro:assets';
import type { Note } from '../utils/notes';
interface Props { photos: Note['data']['photos']; }
const { photos } = Astro.props;
---
{photos.length > 0 && <div class="photo-grid">
  {photos.map((photo) => <figure>
    <Image src={photo.src} alt={photo.alt} widths={[480, 800, 1200]} sizes="(max-width: 700px) 92vw, 440px" loading="lazy" />
    {photo.caption && <figcaption>{photo.caption}</figcaption>}
  </figure>)}
</div>}

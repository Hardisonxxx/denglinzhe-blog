---
interface Props { current: number; last: number; basePath: string; }
const { current, last, basePath } = Astro.props;
const normalizedBase = basePath.endsWith('/') ? basePath : `${basePath}/`;
---
{last > 1 && <nav class="pagination" aria-label="分页">
  {current > 1 ? <a href={current === 2 ? normalizedBase : `${normalizedBase}page/${current - 1}/`}>上一页</a> : <span>上一页</span>}
  <span>{current} / {last}</span>
  {current < last ? <a href={`${normalizedBase}page/${current + 1}/`}>下一页</a> : <span>下一页</span>}
</nav>}

---
const pathname = Astro.url.pathname;
const links = [
  { href: '/notes/', label: '记录', active: pathname.startsWith('/notes/') },
  { href: '/research/', label: '研究', active: pathname.startsWith('/research/') },
  { href: '/about/', label: '关于', active: pathname.startsWith('/about/') }
];
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="林哲的个人档案首页">
    <span class="wordmark-cn">林哲</span><span class="wordmark-en">DENG<br />LINZHE</span>
  </a>
  <nav class="primary-nav" aria-label="主导航">
    {links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <details class="mobile-nav">
    <summary>菜单</summary>
    <nav aria-label="移动端导航">
      {links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
    </nav>
  </details>
</header>

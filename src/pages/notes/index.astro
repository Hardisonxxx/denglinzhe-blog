---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
import FilterNav from '../../components/FilterNav.astro';
import Pagination from '../../components/Pagination.astro';
import { getPublishedNotes } from '../../utils/notes';
const notes = await getPublishedNotes();
const last = Math.max(1, Math.ceil(notes.length / 10));
---
<BaseLayout title="记录 | 林哲的个人档案" description="随笔、照片、阅读与影视记录。">
  <div class="section-heading"><h2>记录</h2><span>NOTES &amp; FRAGMENTS</span></div>
  <FilterNav />
  <NoteList notes={notes.slice(0, 10)} />
  <Pagination current={1} last={last} basePath="/notes/" />
</BaseLayout>

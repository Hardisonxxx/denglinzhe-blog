---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import NoteList from '../../../../components/NoteList.astro';
import FilterNav from '../../../../components/FilterNav.astro';
import Pagination from '../../../../components/Pagination.astro';
import { NOTE_TYPES, NOTE_TYPE_LABELS, getPublishedNotes, type NoteType } from '../../../../utils/notes';
export async function getStaticPaths() {
  return Promise.all(NOTE_TYPES.map(async (type) => ({
    params: { type }, props: { type, notes: await getPublishedNotes(type) }
  })));
}
const { type, notes } = Astro.props as { type: NoteType; notes: Awaited<ReturnType<typeof getPublishedNotes>> };
const last = Math.max(1, Math.ceil(notes.length / 10));
---
<BaseLayout title={`${NOTE_TYPE_LABELS[type]} | 林哲的个人档案`}>
  <div class="section-heading"><h2>{NOTE_TYPE_LABELS[type]}</h2><span>FILTERED NOTES</span></div>
  <FilterNav activeType={type} /><NoteList notes={notes.slice(0, 10)} />
  <Pagination current={1} last={last} basePath={`/notes/type/${type}/`} />
</BaseLayout>
